# ══════════════════════════════════════════════════════════════════════════════
# AI Recruitment Agent System — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your values before starting the server.
# Never commit `.env` to version control.
#
# Usage:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════


# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, no Docker required):
DATABASE_URL=sqlite+aiosqlite:///./data/recruitment.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recruitment_db


# ── Application ────────────────────────────────────────────────────────────────
PRODUCTION_MODE=false

# JWT secret key — change this to a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-change-in-production


# ── AI / LLM APIs ─────────────────────────────────────────────────────────────
# Groq (required) — used for AI question generation & answer evaluation
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini (optional) — used for chatbot features
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# ── Voice / TTS ────────────────────────────────────────────────────────────────
# Sarvam AI (required for interview audio) — Bulbul v3 model
# Get your key at: https://app.sarvam.ai/
SARVAM_API_KEY=sk_your_sarvam_api_key_here


# ── Email — EmailJS (Prescreening & Interview Invites) ─────────────────────────
# EmailJS is used to send automated emails to candidates.
# Set up at: https://www.emailjs.com/
#
# Stage 4 & 5 — Prescreening invitation email template
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Stage 6 — Interview invitation email template (separate template with interview link)
# If left blank, falls back to the defaults above.
EMAILJS_INTERVIEW_SERVICE_ID=service_xxxxxxx
EMAILJS_INTERVIEW_TEMPLATE_ID=template_xxxxxxx
EMAILJS_INTERVIEW_PUBLIC_KEY=your_emailjs_public_key


# ── Email — SMTP (Offer Letters & Onboarding) ─────────────────────────────────
# Used to send offer letters and onboarding documents via SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password


# ── Company & Application URLs ─────────────────────────────────────────────────
COMPANY_NAME="Your Company Name"
HR_ADMIN_EMAIL=hr@yourcompany.com

# Base URLs — update if running on a different port or domain
SCREENING_BASE_URL=http://localhost:8000/candidate-prescreening.html
TALENT_POOL_BASE_URL=http://localhost:8000/talent-pool
COMPANY_CAREERS_BASE_URL=http://localhost:8000/careers


# ── Caching & Message Queue ────────────────────────────────────────────────────
# Redis — used for TTS audio caching and interview session data
# Set to a running Redis URL or leave default (optional; system works without Redis)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ — used for event-driven messaging in production mode
# Leave blank to use the built-in in-memory event bus
RABBITMQ_URL=


# ── Interview Configuration ────────────────────────────────────────────────────
# Total number of interview turns per session
INTERVIEW_TOTAL_TURNS=10

# Number of turns in the HR phase (remaining turns = Technical phase)
INTERVIEW_HR_PHASE_TURNS=5


# ── Screening Weights ─────────────────────────────────────────────────────────
# Controls how rule-based vs LLM scoring is weighted in Stage 3 screening
# Must add up to 1.0
SCREENING_RULE_WEIGHT=0.6
SCREENING_LLM_WEIGHT=0.4

# Minimum LLM score (0–100) required for a candidate to pass screening
SCREENING_LLM_THRESHOLD=50.0


# ── Storage Backend ────────────────────────────────────────────────────────────
# "local" stores resumes/documents on disk; "s3" stores in AWS S3
STORAGE_BACKEND=local

# AWS S3 (only required if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=recruitment-resumes
S3_REGION=ap-south-1


# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60


# ── Background Verification (BGV) ─────────────────────────────────────────────
# SpringVerify API for background checks
# Set BGV_MOCK=true to simulate BGV without a real API key during development
BGV_MOCK=true
SPRINGVERIFY_API_KEY=


# ── Chatbot ───────────────────────────────────────────────────────────────────
# Set to true to enable the AI chatbot on the candidate portal
CHATBOT_ENABLED=false


# ── Candidate Sourcing APIs (Optional) ────────────────────────────────────────
# These are only required if you use active candidate sourcing features

# GitHub — for sourcing developer profiles
GITHUB_API_TOKEN=

# Stack Overflow (300 req/day free without a key)
STACKOVERFLOW_API_KEY=

# AngelList / Wellfound — for startup talent sourcing
ANGELLIST_API_KEY=

# HackerRank — for technical assessments
HACKERRANK_API_KEY=


# ── Job Posting APIs (Optional) ───────────────────────────────────────────────
# These are only required if you use automated job posting features

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_COMPANY_ID=
LINKEDIN_TALENT_API_KEY=

# Indeed
INDEED_API_KEY=
INDEED_EMPLOYER_ID=

# Adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_FEED_URL=
